# API Configuration
# Update this to your deployed Worker URL for production
VITE_API_URL=https://govmonitor-worker.your-subdomain.workers.dev/api

# Google OAuth Configuration
# Get your client ID from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional: Default API Key (not recommended for production)
# Users can also log in through the UI
# VITE_API_KEY=your-api-key-here
